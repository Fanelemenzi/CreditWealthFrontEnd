# Copy to .env and replace the placeholder Firebase values.

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123

# Base URLs must not include /api. Use HTTPS in production.
# Business API: authentication/profile and business assessments.
VITE_API_ONE_URL=http://localhost:8080
# Personal API: personal assessment sessions and credit scores.
VITE_API_TWO_URL=http://localhost:8000
VITE_ENABLE_BUSINESS_SCORE=false

# Legacy names are still supported by the axios service.
VITE_AUTH_API_BASE_URL=http://localhost:8080
VITE_OTHER_API_BASE_URL=http://localhost:8000
